# Sockrocket default configuration file
# After startup, nodes can be added via subscription links or manually
#
# Usage: sockrocket-cli config.yaml

listen_addr: "127.0.0.1"
socks_port: 1080
http_port: 1087

# Active node index (null = direct mode)
active_node: null

# Node list (auto-populated via subscriptions after startup)
nodes: []

# Subscription sources (fetched on startup)
# Uncomment and fill in your subscription URL:
# subscriptions:
#   - name: "My Subscription"
#     url: "https://example.com/subscribe?token=xxx"
#     format: "auto"
subscriptions: []

# Routing rules (higher priority first; equal priority keeps list order)
# Examples:
#   - rule_type: "domain-suffix"
#     pattern: "google.com"
#     target: "proxy"
#     priority: 10
#   - rule_type: "dst-port"
#     pattern: "443"
#     target: "direct"
#   - rule_type: "geoip"
#     pattern: "CN"
#     target: "direct"
rules: []
