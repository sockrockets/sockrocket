# Optional live-probe credentials for ignored integration tests.
# Copy to ../.local/live.env and fill in (never commit .local/).
#
# SOCKROCKET_SUB_URL=
# LIVE_SERVER=
# LIVE_PORT=443
# LIVE_UUID=
# LIVE_PASSWORD=
# LIVE_SS_PASSWORD=
# LIVE_SS_CIPHER=2022-blake3-aes-256-gcm
# LIVE_ST_PASSWORD=
# LIVE_ST_HOST=
# LIVE_WS_HOST=
# LIVE_SNI=
# LIVE_TLS=false
# LIVE_REALITY_PUBLIC_KEY=
# LIVE_REALITY_SHORT_ID=
